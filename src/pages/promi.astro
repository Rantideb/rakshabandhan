---
// src/pages/promi.astro - Dedicated Personalized Raksha Bandhan Sanctuary for Promi & Ranti
import Layout from '../layouts/Layout.astro';

const promiMemories = [
  { 
    src: '/images/promi/promi-6.webp', 
    title: 'Pavitra Deepa & Festive Blessings', 
    subtitle: 'Shining bright with grace, devotion, and sacred auspiciousness.',
    tag: 'FESTIVE RITUAL'
  },
  { 
    src: '/images/promi/promi-5.webp', 
    title: 'Joyful Sister & Nature Smiles', 
    subtitle: 'Cherished moments of pure laughter and sisterly warmth.',
    tag: 'CHERISHED SMILE'
  },
  { 
    src: '/images/promi/promi-1.webp', 
    title: 'Grace & Traditional Radiance', 
    subtitle: 'The pride of our family and the heart of every festival.',
    tag: 'SACRED BOND'
  },
  { 
    src: '/images/promi/promi-4.webp', 
    title: 'Childhood Wanderer & Companion', 
    subtitle: 'Through all adventures, trips, and shared mischief.',
    tag: 'PARTNER IN CRIME'
  },
  { 
    src: '/images/promi/promi-2.webp', 
    title: 'Eternal Sisterly Affection', 
    subtitle: 'A lifelong bond protected by prayers and unconditional love.',
    tag: 'RAKSHA KAVACH'
  },
];
---

<Layout title="For Promi • Sacred Sibling Sanctuary with Ranti">
  <div class="promi-container">
    
    <!-- Top Sacred Header with Promi's Portrait -->
    <div class="promi-header-block">
      <div class="promi-portrait-aura">
        <img src="/images/promi/promi-1.webp" alt="Promi" class="promi-avatar-img" />
        <div class="portrait-gold-ring"></div>
      </div>

      <div class="section-badge">
        <span class="badge-symbol">ॐ</span>
        <span data-i18n="promiSanctuaryBadge">Dedicated Sibling Sanctuary</span>
      </div>

      <h1 class="promi-main-title" data-i18n="promiMainTitleName">
        Dearest Promi,
      </h1>
      <p class="promi-sub-title" data-i18n="promiSubTitle">
        A consecrated Raksha Bandhan sanctuary handcrafted with eternal love, cherished childhood smiles, and endless blessings from your brother Ranti.
      </p>
    </div>

    <!-- Sacred Shloka Banner -->
    <div class="shloka-banner promi-shloka-card">
      <p class="shloka-text">
        येन बद्धो बली राजा दानवेन्द्रो महाबलः।<br />
        तेन त्वां प्रतिबद्धनामि रक्षे मा चल मा चल॥
      </p>
      <p class="shloka-meaning" data-i18n="promiShlokaMeaning">
        "May the sacred bond of protection that shields the universe guard and bless you, Promi, in every step of your life."
      </p>
    </div>

    <!-- 5-Tab Interactive Experience for Promi -->
    <div class="promi-tab-nav">
      <button class="promi-tab-btn active" id="tab-btn-letter" data-tab="letter" data-i18n="tabLetter">
        Ranti's Letter
      </button>
      <button class="promi-tab-btn" id="tab-btn-memories" data-tab="memories" data-i18n="tabMemories">
        Smriti Gallery (Memories)
      </button>
      <button class="promi-tab-btn" id="tab-btn-reply" data-tab="reply" data-i18n="tabReply">
        Promi's Reply &amp; Wishes
      </button>
      <button class="promi-tab-btn" id="tab-btn-rakhi" data-tab="rakhi" data-i18n="tabRakhi">
        Promi's Raksha Sutra
      </button>
      <button class="promi-tab-btn" id="tab-btn-vows" data-tab="vows" data-i18n="tabVows">
        Sacred Promises &amp; Shagun
      </button>
    </div>

    <!-- Tab 1: Personal Letter from Ranti -->
    <div class="promi-tab-content active" id="tab-content-letter">
      <div class="glass-panel promi-card">
        <div class="card-motif-header">
          <span class="motif-symbol">ॐ</span>
          <span class="motif-title" data-i18n="cardMotifTitle">शुभ रक्षा बन्धनम्</span>
          <span class="motif-symbol">卐</span>
        </div>

        <div class="letter-meta-row">
          <span class="meta-tag" data-i18n="fromRantiToPromi">From Ranti to Promi</span>
          <span class="meta-date" data-i18n="promiShravanaDate">Shravana Purnima 2026</span>
        </div>

        <div class="personal-letter-body" id="promi-letter-text" data-i18n="promiLetterContent">
Dear Promi,

On this sacred occasion of Raksha Bandhan, I want to celebrate the priceless gift of having you in my life. Looking through all our shared memories, silly disagreements, late-night laughter, and silent understandings, our sibling bond has always been my greatest strength.

No matter where life takes us or how fast time flies, my promise to you remains unwavering:
- I will always be your steadfast supporter and protective shield.
- I will celebrate your greatest victories and stand by you in your hardest days.
- Our childhood memories and mutual trust will forever remain sacred and safe with me.

May this auspicious Shravana Purnima shower you with good health, immense peace, boundless joy, and success in everything you pursue.
        </div>

        <div class="letter-signoff-block">
          <span class="signoff-note" data-i18n="promiSignoffNote">With all my love, prayers &amp; lifelong protection,</span>
          <h3 class="signoff-name" data-i18n="senderRanti">Ranti</h3>
        </div>

        <!-- Dynamic Custom AI Composer for Ranti to Promi -->
        <div class="promi-ai-bar">
          <div class="promi-ai-label" data-i18n="promiAiComposerLabel">Personalize &amp; Compose with Ranti:</div>
          
          <div class="promi-composer-inputs">
            <div class="input-col">
              <label class="sub-label" for="promi-memory-input" data-i18n="promiMemoryLabel">Specific Memory, Nickname or Inside Joke (Optional)</label>
              <input
                type="text"
                id="promi-memory-input"
                class="input-field"
                placeholder="e.g. late night chats, favorite food, childhood secrets, funny moments"
                data-i18n-placeholder="promiMemoryPlaceholder"
              />
            </div>

            <div class="input-col">
              <label class="sub-label" for="promi-wish-input" data-i18n="promiWishLabel">Special Wish or Prayer (Optional)</label>
              <input
                type="text"
                id="promi-wish-input"
                class="input-field"
                placeholder="e.g. endless happiness, peace of mind, health, career success"
                data-i18n-placeholder="promiWishPlaceholder"
              />
            </div>
          </div>

          <div class="promi-ai-buttons">
            <button type="button" class="btn-promi-ai" data-tone="Vedic Sanskrit Blessing & Eternal Protection" data-i18n="promiToneVedic">
              Vedic Ashirwad
            </button>
            <button type="button" class="btn-promi-ai" data-tone="Childhood Mischief, Shared Secrets & Sibling Laughs" data-i18n="promiToneMemories">
              Childhood Memories
            </button>
            <button type="button" class="btn-promi-ai" data-tone="Unbreakable Shield, Deep Emotional Support & Anchor" data-i18n="promiToneShield">
              Protective Shield
            </button>
            <button type="button" class="btn-promi-ai active-cta" id="btn-generate-promi-custom" data-i18n="promiComposeCustomBtn">
              Compose with Custom Details
            </button>
          </div>
          <div class="promi-ai-status" id="promi-ai-status" style="display: none;"></div>
        </div>

        <div class="card-interactive-footer">
          <button class="btn-primary" id="btn-shower-petals" data-i18n="btnShowerPetals">
            Shower Flower Petals &amp; Blessings
          </button>
          <button class="btn-secondary" id="btn-save-promi-card" data-i18n="btnSaveKeepsake">
            Preserve Keepsake (PNG)
          </button>
        </div>
      </div>
    </div>

    <!-- Tab 2: High-End Curated Memories Showcase (Smriti Mala) -->
    <div class="promi-tab-content" id="tab-content-memories">
      <div class="glass-panel promi-card">
        <div class="card-motif-header">
          <span class="motif-symbol">ॐ</span>
          <span class="motif-title" data-i18n="galleryHeader">Smriti Mala • Cherished Memories</span>
          <span class="motif-symbol">卐</span>
        </div>

        <!-- Featured Spotlight Viewer -->
        <div class="spotlight-viewer">
          <div class="spotlight-image-box">
            <img src="/images/promi/promi-6.webp" alt="Featured Memory" id="spotlight-active-img" class="spotlight-img" />
            <div class="spotlight-overlay">
              <span class="spotlight-tag" id="spotlight-tag">FESTIVE RITUAL</span>
              <h3 class="spotlight-title" id="spotlight-title">Pavitra Deepa &amp; Festive Blessings</h3>
              <p class="spotlight-desc" id="spotlight-desc">Shining bright with grace, devotion, and sacred auspiciousness.</p>
            </div>
          </div>
          
          <div class="spotlight-controls">
            <button class="spotlight-arrow" id="spotlight-prev" aria-label="Previous Memory">&larr;</button>
            <div class="spotlight-dots" id="spotlight-dots">
              {promiMemories.map((_, i) => (
                <span class={`spotlight-dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
              ))}
            </div>
            <button class="spotlight-arrow" id="spotlight-next" aria-label="Next Memory">&rarr;</button>
          </div>
        </div>

        <!-- Editorial Memory Strip -->
        <div class="memory-filmstrip">
          {promiMemories.map((item, index) => (
            <div class={`filmstrip-thumb ${index === 0 ? 'active' : ''}`} data-index={index} data-src={item.src} data-title={item.title} data-desc={item.subtitle} data-tag={item.tag}>
              <img src={item.src} alt={item.title} loading="lazy" />
              <div class="thumb-tint"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Tab 3: Promi's Interactive Reply & Return Wish -->
    <div class="promi-tab-content" id="tab-content-reply">
      <div class="glass-panel promi-card">
        <div class="card-motif-header">
          <span class="motif-symbol">ॐ</span>
          <span class="motif-title" data-i18n="replyTabTitle">Promi's Return Blessing to Ranti</span>
          <span class="motif-symbol">卐</span>
        </div>

        <p class="reply-intro" data-i18n="replyTabIntro">
          Promi, add your personal reply, return blessings, or festive demands for Ranti below:
        </p>

        <div class="reply-form-group">
          <label class="control-label" for="promi-reply-tone" data-i18n="replyStyleLabel">Select Promi's Wish Style</label>
          <div class="promi-reply-ai-buttons">
            <button type="button" class="btn-reply-preset" data-reply-type="sweet" data-i18n="replySweet">
              Loving Sister Ashirwad
            </button>
            <button type="button" class="btn-reply-preset" data-reply-type="mischief" data-i18n="replyMischief">
              Playful Treat &amp; Gift Demand
            </button>
            <button type="button" class="btn-reply-preset" data-reply-type="gratitude" data-i18n="replyGratitude">
              Deep Gratitude &amp; Bond
            </button>
          </div>
        </div>

        <div class="reply-form-group">
          <label class="control-label" for="promi-reply-message" data-i18n="replyMsgLabel">Promi's Message to Ranti</label>
          <textarea
            id="promi-reply-message"
            class="textarea-field"
            rows="5"
            placeholder="Dear Ranti, thank you for always being there for me..."
            data-i18n-placeholder="replyMsgPlaceholder"
          ></textarea>
          <div class="promi-ai-status" id="promi-reply-ai-status" style="display: none;"></div>
        </div>

        <div class="reply-form-group">
          <label class="control-label" for="promi-return-shagun" data-i18n="replyShagunLabel">Promi's Sibling Demand / Gift Choice</label>
          <select id="promi-return-shagun" class="select-field">
            <option value="Unlimited sweets, snacks, and favorite festive treats" data-i18n="replyShagun1">Unlimited Sweets &amp; Favorite Festive Treats</option>
            <option value="A dedicated day out together with family celebration" data-i18n="replyShagun2">A Dedicated Day Out &amp; Family Celebration</option>
            <option value="Special Raksha Bandhan gift of my choice on demand" data-i18n="replyShagun3">Special Rakhi Gift of My Choice</option>
            <option value="Lifelong promise to listen to all my stories &amp; secrets" data-i18n="replyShagun4">Lifelong Promise to Listen to All My Stories</option>
          </select>
        </div>

        <div class="card-interactive-footer">
          <button class="btn-primary" id="btn-save-promi-reply-png" data-i18n="btnSaveReplyPng">
            Save Promi's Reply Card (PNG)
          </button>
          <button class="btn-secondary" id="btn-celebrate-reply" data-i18n="btnCelebrateReply">
            Offer Blessings to Ranti
          </button>
        </div>
      </div>
    </div>

    <!-- Tab 4: Promi's Dedicated Handcrafted Raksha Sutra -->
    <div class="promi-tab-content" id="tab-content-rakhi">
      <div class="glass-panel promi-card rakhi-center-card">
        <div class="rakhi-showcase-box">
          <canvas id="promi-rakhi-canvas" width="420" height="420"></canvas>
        </div>
        <div class="rakhi-details-box">
          <h3 data-i18n="promiRakhiHeading">Consecrated Raksha Sutra for Promi</h3>
          <p class="rakhi-desc" data-i18n="promiRakhiDesc">
            Woven with pure Kumkum &amp; Suvarna silk strands, centered with the sacred Om medallion and inscribed with your name.
          </p>
          <div class="rakhi-actions">
            <button class="btn-primary" id="download-promi-rakhi-btn" data-i18n="btnDownloadPromiRakhi">
              Download Raksha Sutra (PNG)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 5: Sacred Vows & Special Shagun Chest -->
    <div class="promi-tab-content" id="tab-content-vows">
      <div class="glass-panel promi-card">
        <h3 class="vows-heading" data-i18n="promiVowsHeading">Ranti's Sacred Commitments to Promi</h3>
        <p class="vows-sub" data-i18n="promiVowsSub">Eternal vows formalized under the sacred Shravana Purnima.</p>

        <div class="vows-list">
          <div class="vow-item">
            <div class="vow-badge">I</div>
            <div>
              <h4 data-i18n="vow1Title">The Unbreakable Shield</h4>
              <p data-i18n="vow1Desc">Unconditional presence and protection whenever you need advice, support, or someone to stand in your corner.</p>
            </div>
          </div>
          <div class="vow-item">
            <div class="vow-badge">II</div>
            <div>
              <h4 data-i18n="vow2Title">The Secret Vault</h4>
              <p data-i18n="vow2Desc">All shared childhood mischief, confidential talks, and secret wishes are sealed forever with absolute trust.</p>
            </div>
          </div>
          <div class="vow-item">
            <div class="vow-badge">III</div>
            <div>
              <h4 data-i18n="vow3Title">Unconditional Food &amp; Treat Pass</h4>
              <p data-i18n="vow3Desc">Guaranteed sponsorship of your favorite treats, sweets, and celebratory dinners on demand.</p>
            </div>
          </div>
          <div class="vow-item">
            <div class="vow-badge">IV</div>
            <div>
              <h4 data-i18n="vow4Title">Eternal Well-Wishing (Ashirwad)</h4>
              <p data-i18n="vow4Desc">Daily prayers for your happiness, peace of mind, self-fulfillment, and lifelong prosperity.</p>
            </div>
          </div>
        </div>

        <div class="shagun-box-card">
          <div class="shagun-icon-gold">ॐ</div>
          <div class="shagun-details">
            <span class="shagun-label" data-i18n="shagunLabelCard">OFFICIAL SIBLING SHAGUN DEED</span>
            <p class="shagun-val" data-i18n="shagunValCard">Akhand Sneha, Eternal Protection &amp; Boundless Blessings</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Navigation Back to Main Site -->
    <div class="promi-bottom-nav">
      <a href="/" class="btn-secondary" data-i18n="btnReturnHome">
        Return to Main Raksha Bandhan Sanctuary
      </a>
    </div>

  </div>

  <canvas id="promi-celebration-canvas"></canvas>
</Layout>

<style>
  .promi-container {
    max-width: 840px;
    margin: 0 auto;
    padding: 3rem 1rem 5rem;
  }

  .promi-header-block {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Promi Avatar Portrait with perfect top crop */
  .promi-portrait-aura {
    position: relative;
    width: 120px;
    height: 120px;
    margin-bottom: 1.25rem;
  }

  .promi-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: top 15% center;
    border: 3px solid var(--accent-gold);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.35);
    display: block;
  }

  .portrait-gold-ring {
    position: absolute;
    top: -6px;
    left: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 50%;
    border: 1px dashed rgba(245, 158, 11, 0.4);
    pointer-events: none;
  }

  .promi-main-title {
    font-size: 2.6rem;
    margin: 0.6rem 0 0.8rem;
  }

  .promi-sub-title {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .promi-sub-title strong {
    color: var(--text-gold);
  }

  .promi-shloka-card {
    margin: 1.5rem auto 2.2rem;
  }

  /* Stepper Tab Navigation */
  .promi-tab-nav {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    background: var(--surface-sunken);
    padding: 0.35rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
  }

  .promi-tab-btn {
    padding: 0.5rem 1.15rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .promi-tab-btn:hover {
    color: var(--text-main);
  }

  .promi-tab-btn.active {
    background: var(--surface-2);
    border-color: var(--border-gold);
    color: var(--text-gold);
    font-weight: 600;
  }

  /* Tab Content */
  .promi-tab-content {
    display: none;
    animation: fadeInTab 0.3s ease;
  }

  .promi-tab-content.active {
    display: block;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .promi-card {
    padding: 2.5rem 2.2rem;
    margin-bottom: 2rem;
  }

  .card-motif-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .motif-symbol {
    font-family: 'Noto Serif Devanagari', serif;
    font-size: 1.3rem;
    color: var(--accent-gold);
    font-weight: bold;
  }

  .motif-title {
    font-family: 'Noto Serif Devanagari', serif;
    font-size: 1.15rem;
    color: var(--text-gold);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .letter-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .meta-tag {
    color: var(--text-gold);
    font-weight: 600;
  }

  .meta-date {
    color: var(--text-muted);
  }

  .personal-letter-body {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.85;
    white-space: pre-wrap;
    margin-bottom: 2rem;
  }

  .letter-signoff-block {
    text-align: right;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .signoff-note {
    font-size: 0.88rem;
    color: var(--text-muted);
    display: block;
  }

  .signoff-name {
    font-size: 1.4rem;
    color: var(--text-gold);
    margin-top: 0.3rem;
  }

  .promi-ai-bar {
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.2rem 1.4rem;
    margin-bottom: 1.75rem;
    text-align: left;
  }

  .promi-ai-label {
    font-size: 0.88rem;
    color: var(--text-gold);
    font-weight: 600;
    margin-bottom: 0.8rem;
    text-align: center;
  }

  .promi-composer-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .input-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sub-label {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .promi-ai-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn-promi-ai, .btn-reply-preset {
    background: var(--surface-2);
    border: 1px solid var(--border-gold);
    color: var(--text-gold);
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-promi-ai.active-cta {
    background: var(--accent-gold);
    color: #FFFFFF !important;
    border-color: var(--accent-gold);
    box-shadow: var(--shadow-sm);
  }

  .btn-promi-ai.active-cta:hover {
    background: var(--accent-gold-light);
    color: #FFFFFF !important;
  }

  .promi-ai-status {
    font-size: 0.8rem;
    color: var(--text-gold);
    margin-top: 0.5rem;
    text-align: center;
  }

  /* Spotlight Memory Viewer */
  .spotlight-viewer {
    position: relative;
    max-width: 580px;
    margin: 0 auto 1.5rem;
  }

  .spotlight-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    max-height: 520px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border-gold);
    box-shadow: 0 8px 24px rgba(180, 83, 9, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spotlight-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top 12% center;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  .spotlight-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.75rem 1.5rem 1.25rem;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.88) 70%, transparent 100%);
    text-align: left;
    border-top: 1px solid rgba(180, 83, 9, 0.15);
  }

