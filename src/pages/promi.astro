        tag: 'পূজার আচার'
      },
      { 
        src: '/images/promi/promi-5.webp', 
        title: 'প্রকৃতির মাঝে বোনের মিষ্টি হাসি', 
        subtitle: 'নির্মল আনন্দ আর ভাই-বোনের মধুর স্মৃতির প্রতিচ্ছবি।',
        tag: 'মধুর হাসি'
      },
      { 
        src: '/images/promi/promi-1.webp', 
        title: 'স্নেহের বোন ও উৎসবের আনন্দ', 
        subtitle: 'আমাদের পরিবারের গর্ব এবং প্রতিটি উৎসবের প্রাণ।',
        tag: 'পবিত্র বন্ধন'
      },
      { 
        src: '/images/promi/promi-4.webp', 
        title: 'শৈশবের খেলার সঙ্গী ও খুনসুটি', 
        subtitle: 'সমস্ত ভ্রমণ, আড্ডা আর শৈশবের অমলিন স্মৃতি।',
        tag: 'খুনসুটির সঙ্গী'
      },
      { 
        src: '/images/promi/promi-2.webp', 
        title: 'ভাই-বোনের শাশ্বত স্নেহ ও ভরসা', 
        subtitle: 'চিরন্তন ভালোবাসায় সুরক্ষিত এক অটুট আত্মিক বন্ধন।',
        tag: 'রক্ষাকবচ'
      },
    ]
  };

  let currentMemIdx = 0;
  const spotImg = document.getElementById('spotlight-active-img') as HTMLImageElement;
  const spotTag = document.getElementById('spotlight-tag');
  const spotTitle = document.getElementById('spotlight-title');
  const spotDesc = document.getElementById('spotlight-desc');
  const dots = document.querySelectorAll('.spotlight-dot');
  const filmThumbs = document.querySelectorAll('.filmstrip-thumb');

  function updateSpotlight(index: number) {
    const lang = (localStorage.getItem('rb_lang') || 'en') as 'en' | 'bn';
    const list = memoriesData[lang] || memoriesData.en;

    if (index < 0) index = list.length - 1;
    if (index >= list.length) index = 0;
    currentMemIdx = index;

    const mem = list[currentMemIdx];
    if (spotImg && spotTag && spotTitle && spotDesc) {
      spotImg.style.opacity = '0.4';
      setTimeout(() => {
        spotImg.src = mem.src;
        spotTag.textContent = mem.tag;
        spotTitle.textContent = mem.title;
        spotDesc.textContent = mem.subtitle;
        spotImg.style.opacity = '1';
      }, 150);
    }

    dots.forEach((d, i) => d.classList.toggle('active', i === currentMemIdx));
    filmThumbs.forEach((th, i) => th.classList.toggle('active', i === currentMemIdx));
  }

  window.addEventListener('languageChange', () => {
    updateSpotlight(currentMemIdx);
  });

  document.getElementById('spotlight-prev')?.addEventListener('click', () => {
    updateSpotlight(currentMemIdx - 1);
    soundEngine.playShimmer();
  });

  document.getElementById('spotlight-next')?.addEventListener('click', () => {
    updateSpotlight(currentMemIdx + 1);
    soundEngine.playCelebrationChime();
    triggerPromiPetals();
  });

  filmThumbs.forEach(th => {
    th.addEventListener('click', () => {
      const idx = parseInt(th.getAttribute('data-index') || '0', 10);
      updateSpotlight(idx);
      soundEngine.playCelebrationChime();
    });
  });

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
      updateSpotlight(idx);
    });
  });

  // Canvas Petal System
  const canvas = document.getElementById('promi-celebration-canvas') as HTMLCanvasElement;
  let ctx: CanvasRenderingContext2D | null = null;
  if (canvas) ctx = canvas.getContext('2d');

  interface PetalParticle {
    x: number;
    y: number;
    size: number;
    color: string;
    vx: number;
    vy: number;
    rotation: number;
    vr: number;
    alpha: number;
  }
  let petals: PetalParticle[] = [];

  function triggerPromiPetals() {
    if (!canvas || !ctx) return;
    canvas.width = document.documentElement.clientWidth || window.innerWidth;
    canvas.height = window.innerHeight;

    const colors = ['#F59E0B', '#FBBF24', '#DC2626', '#FFFFFF', '#EA580C'];
    for (let i = 0; i < 75; i++) {
      petals.push({
        x: canvas.width / 2,
        y: canvas.height / 3,
        size: Math.random() * 7 + 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        vx: (Math.random() - 0.5) * 12,
        vy: (Math.random() - 0.7) * 12,
        rotation: Math.random() * Math.PI * 2,
        vr: (Math.random() - 0.5) * 0.15,
        alpha: 1.0,
      });
    }
    render();
  }

  function render() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = petals.length - 1; i >= 0; i--) {
      const p = petals[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.2;
      p.rotation += p.vr;
      p.alpha -= 0.015;

      if (p.alpha <= 0) {
        petals.splice(i, 1);
        continue;
      }

      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    if (petals.length > 0) requestAnimationFrame(render);
  }

  // Shower Petals Button
  const showerBtn = document.getElementById('btn-shower-petals');
  showerBtn?.addEventListener('click', () => {
    soundEngine.playCelebrationChime();
    triggerPromiPetals();
    setTimeout(triggerPromiPetals, 350);
  });

  // Dedicated Rakhi Canvas Drawer
  function drawPromiRakhi() {
    const rCanvas = document.getElementById('promi-rakhi-canvas') as HTMLCanvasElement;
    if (!rCanvas) return;
    const rCtx = rCanvas.getContext('2d');
    if (!rCtx) return;

    const w = rCanvas.width;
    const h = rCanvas.height;
    const cx = w / 2;
    const cy = h / 2;

    rCtx.clearRect(0, 0, w, h);

    // 1. Thread
    rCtx.save();
    rCtx.lineWidth = 6;
    rCtx.lineCap = 'round';
    rCtx.strokeStyle = '#DC2626';
    rCtx.beginPath();
    rCtx.moveTo(20, cy - 3);
    rCtx.lineTo(w - 20, cy - 3);
    rCtx.stroke();

    rCtx.strokeStyle = '#F59E0B';
    rCtx.beginPath();
    rCtx.moveTo(20, cy + 3);
    rCtx.lineTo(w - 20, cy + 3);
    rCtx.stroke();
    rCtx.restore();

    // 2. Pearls
    const offsets = [-130, -100, -70, 70, 100, 130];
    offsets.forEach((ox, idx) => {
      rCtx.save();
      rCtx.beginPath();
      const r = idx % 2 === 0 ? 10 : 7;
      rCtx.arc(cx + ox, cy, r, 0, Math.PI * 2);
      const grad = rCtx.createRadialGradient(cx + ox - 2, cy - 2, 1, cx + ox, cy, r);
      grad.addColorStop(0, '#FFFFFF');
      grad.addColorStop(0.7, '#E2E8F0');
      grad.addColorStop(1, '#94A3B8');
      rCtx.fillStyle = grad;
      rCtx.shadowColor = 'rgba(0,0,0,0.4)';
      rCtx.shadowBlur = 4;
      rCtx.fill();
      rCtx.restore();
    });

    // 3. Rosette Base
    rCtx.save();
    const petalsCount = 16;
    for (let i = 0; i < petalsCount; i++) {
      const angle = (i * Math.PI * 2) / petalsCount;
      const px = cx + Math.cos(angle) * 48;
      const py = cy + Math.sin(angle) * 48;
      rCtx.beginPath();
      rCtx.arc(px, py, 10, 0, Math.PI * 2);
      rCtx.fillStyle = i % 2 === 0 ? '#F59E0B' : '#DC2626';
      rCtx.fill();
    }

    // Gold Outer Core
    rCtx.beginPath();
    rCtx.arc(cx, cy, 48, 0, Math.PI * 2);
    const cGrad = rCtx.createRadialGradient(cx, cy, 5, cx, cy, 48);
    cGrad.addColorStop(0, '#FDE68A');
    cGrad.addColorStop(0.6, '#F59E0B');
    cGrad.addColorStop(1, '#B45309');
    rCtx.fillStyle = cGrad;
    rCtx.shadowColor = '#F59E0B';
    rCtx.shadowBlur = 12;
    rCtx.fill();

    // Crimson Inner Core
    rCtx.beginPath();
    rCtx.arc(cx, cy, 34, 0, Math.PI * 2);
    rCtx.fillStyle = '#7F1D1D';
    rCtx.fill();

    // Om Center
    rCtx.font = 'bold 30px "Noto Serif Devanagari", serif';
    rCtx.fillStyle = '#FEF3C7';
    rCtx.textAlign = 'center';
    rCtx.textBaseline = 'middle';
    rCtx.fillText('ॐ', cx, cy + 2);

    // Inscription for Promi
    rCtx.font = 'bold 12px "Outfit", sans-serif';
    rCtx.fillStyle = '#FDE68A';
    rCtx.fillText('PROMI', cx, cy + 62);
    rCtx.restore();
  }

  // Draw on start
  drawPromiRakhi();

  // Download Rakhi button
  document.getElementById('download-promi-rakhi-btn')?.addEventListener('click', () => {
    const rCanvas = document.getElementById('promi-rakhi-canvas') as HTMLCanvasElement;
