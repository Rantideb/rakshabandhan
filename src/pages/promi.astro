  // Save Card PNG
  document.getElementById('btn-save-promi-card')?.addEventListener('click', () => {
    const offCanvas = document.createElement('canvas');
    offCanvas.width = 800;
    offCanvas.height = 700;
    const oCtx = offCanvas.getContext('2d');
    if (!oCtx) return;

    oCtx.fillStyle = '#0F121C';
    oCtx.fillRect(0, 0, 800, 700);

    oCtx.strokeStyle = '#F59E0B';
    oCtx.lineWidth = 4;
    oCtx.strokeRect(20, 20, 760, 660);

    oCtx.fillStyle = '#FDE68A';
    oCtx.font = 'bold 24px serif';
    oCtx.textAlign = 'center';
    oCtx.fillText('RAKSHA BANDHAN SMRITI PATRA', 400, 80);

    oCtx.textAlign = 'left';
    oCtx.fillStyle = '#FFFFFF';
    oCtx.font = '20px serif';
    oCtx.fillText('To: Promi', 60, 150);
    oCtx.fillText('From: Ranti', 60, 190);

    oCtx.font = '15px sans-serif';
    oCtx.fillStyle = '#E2E8F0';
    oCtx.fillText('Dear Promi, on this sacred Raksha Bandhan, I reaffirm my lifelong promise', 60, 250);
    oCtx.fillText('to protect, support, and cherish our sacred sibling bond with eternal love.', 60, 280);

    oCtx.fillStyle = '#F59E0B';
    oCtx.font = '16px serif';
    oCtx.fillText('Shagun: Akhand Sneha, Eternal Protection & Prosperity', 60, 360);

    const a = document.createElement('a');
    a.download = `promi-rakhi-memory-${Date.now()}.png`;
    a.href = offCanvas.toDataURL('image/png');
    a.click();
    soundEngine.playCelebrationChime();
  });

  // Promi Dynamic Blessing Re-composer (Ranti to Promi)
  const aiStatusEl = document.getElementById('promi-ai-status');
  const letterBodyEl = document.getElementById('promi-letter-text');
  const aiButtons = document.querySelectorAll('.btn-promi-ai');
  const memoryInput = document.getElementById('promi-memory-input') as HTMLInputElement;
  const wishInput = document.getElementById('promi-wish-input') as HTMLInputElement;

  async function composePromiLetter(tone: string) {
    const memoryText = memoryInput?.value.trim();
    const wishText = wishInput?.value.trim();

    if (aiStatusEl) {
      aiStatusEl.style.display = 'block';
      aiStatusEl.textContent = 'Composing a personalized blessing with Ranti...';
    }

    let promptDetails = `Write an authentic, touching personal Raksha Bandhan message from brother Ranti to his sister Promi highlighting ${tone}.`;
    if (memoryText) {
      promptDetails += ` Incorporate this special shared memory / inside note: "${memoryText}".`;
    }
    if (wishText) {
      promptDetails += ` Include this heartfelt prayer or wish: "${wishText}".`;
    }
    promptDetails += ' Keep it dignified, warm, heartfelt, and zero emojis.';

    try {
      const res = await fetch('/api/generate-blessing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          toName: 'Promi',
          fromName: 'Ranti',
          relation: 'Sister to Brother',
          tone: tone,
          customPrompt: promptDetails,
        }),
      });

      const data = await res.json() as { message?: string; error?: string };
      if (data && data.message && letterBodyEl) {
        letterBodyEl.textContent = data.message;
        if (aiStatusEl) {
          aiStatusEl.textContent = 'Personalized blessing composed with your custom details.';
          setTimeout(() => { aiStatusEl.style.display = 'none'; }, 3000);
        }
        soundEngine.playCelebrationChime();
        triggerPromiPetals();
        return;
      }
    } catch {
      // Graceful local generation
    }

    // Client-side fallback
    const lang = localStorage.getItem('rb_lang') || 'en';
    let fallback = '';
    if (lang === 'bn') {
      if (tone.includes('Vedic') || tone.includes('Ashirwad')) {
        fallback = `স্নেহের প্রমি,\n\n"येन बद्धो बली राजा दानवेन्द्रो महाबलः। तेन त्वां प्रतिबद्धनामि রক্ষে মা চল মা চল॥"\n\nশ্রাবণ পূর্ণিমার এই পরম পবিত্র লগ্নে ঈশ্বরের কাছে তোমার সার্বিক মঙ্গল, সুস্বাস্থ্য ও অফুরন্ত শান্তির প্রার্থনা করি।${memoryText ? ` আমাদের সেই বিশেষ স্মৃতি: ${memoryText}। ` : ''}জীবনের প্রতিটি পদক্ষেপে ভাই হিসেবে আমি সর্বদাই তোমার পাশে থাকব।\n\nচিরন্তন স্নেহের সাথে,\nরন্তি`;
      } else if (tone.includes('Mischief') || tone.includes('Memories')) {
        fallback = `স্নেহের প্রমি,\n\nশৈশবের খুনসুটি, রাতের আড্ডা আর না-বলা সমস্ত হাসির স্মৃতিই আমার জীবনের সেরা মুহূর্ত।${memoryText ? ` বিশেষ করে আমাদের ${memoryText} এর কথা মনে পড়ে। ` : ''}তোমার মতো মিষ্টি বোন পাওয়া সত্যিই পরম ভাগ্যের।${wishText ? ` তোমার জন্য কামনা করি: ${wishText}।` : ''}\n\nভালোবাসা ও স্নেহের সাথে,\nরন্তি`;
      } else {
        fallback = `স্নেহের প্রমি,\n\nরাখীবন্ধনের এই শুভ দিনে তোমার প্রতি আমার এই অটুট প্রতিজ্ঞা রইল: জীবনের সমস্ত ঋতুতে আমি তোমার অবিচল রক্ষাকবচ ও বিশ্বস্ত ভরসা হয়ে পাশে থাকব।${wishText ? ` তোমার জন্য বিশেষ প্রার্থনা: ${wishText}।` : ''}\n\nচিরন্তন আশীর্বাদ ও ভালোবাসার সাথে,\nরন্তি`;
      }
    } else {
      if (tone.includes('Vedic') || tone.includes('Ashirwad')) {
        fallback = `Dearest Promi,\n\n"येन बद्धो बली राजा दानवेन्द्रो महाबलः। तेन त्वां प्रतिबद्धनामि रक्षे मा चल मा चल॥"\n\nOn this sacred Shravana Purnima, I pray for your lifelong health, boundless joy, and divine prosperity. May our sacred sibling bond always illuminate your path.${memoryText ? ` Cherishing our memories: ${memoryText}.` : ''}\n\nWith eternal love & protection,\nRanti`;
      } else {
        fallback = `Dearest Promi,\n\nFrom our childhood giggles to our silent understandings, having you as my sister is the greatest blessing. I promise to always stand by you as your steadfast protector and greatest supporter.${wishText ? ` Praying for ${wishText}.` : ''}\n\nWith all my love,\nRanti`;
      }
    }

    if (letterBodyEl) letterBodyEl.textContent = fallback;
    if (aiStatusEl) {
      aiStatusEl.textContent = 'Personalized blessing composed with your custom details.';
      setTimeout(() => { aiStatusEl.style.display = 'none'; }, 3000);
    }
    soundEngine.playCelebrationChime();
    triggerPromiPetals();
  }

  aiButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tone = btn.getAttribute('data-tone') || 'Heartfelt Sister-Brother Blessing & Eternal Support';
      composePromiLetter(tone);
    });
  });

  // Promi's Reply Helpers (Promi to Ranti)
  const replyTextArea = document.getElementById('promi-reply-message') as HTMLTextAreaElement;
  const replyAiStatus = document.getElementById('promi-reply-ai-status');
  const replyPresetBtns = document.querySelectorAll('.btn-reply-preset');

  replyPresetBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const replyType = btn.getAttribute('data-reply-type') || 'sweet';
      let promptDescription = 'A heartfelt sisterly reply and blessing to Ranti, expressing deep gratitude and love for Raksha Bandhan.';
      if (replyType === 'mischief') {
        promptDescription = 'A playful, sweet sibling reply to Ranti demanding festive sweets, favorite treats, and teasing him while sending warm Rakhi blessings.';
      } else if (replyType === 'gratitude') {
        promptDescription = 'A deep, reverent sisterly message to Ranti thanking him for being an unwavering shield, protector, and lifelong companion.';
      }

      if (replyAiStatus) {
        replyAiStatus.style.display = 'block';
        replyAiStatus.textContent = 'Composing Promi\'s return wish...';
      }

      try {
        const res = await fetch('/api/generate-blessing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            toName: 'Ranti',
            fromName: 'Promi',
            relation: 'Sister to Brother',
            tone: promptDescription,
            customPrompt: `Write a sweet, authentic Raksha Bandhan reply from sister Promi to her brother Ranti. ${promptDescription} Keep it natural, warm, and zero emojis.`
          })
        });

        const data = await res.json() as { message?: string; error?: string };
        if (res.ok && data.message && replyTextArea) {
          replyTextArea.value = data.message;
          if (replyAiStatus) {
            replyAiStatus.textContent = 'Promi\'s reply composed.';
            setTimeout(() => { replyAiStatus.style.display = 'none'; }, 2500);
          }
          soundEngine.playCelebrationChime();
        }
      } catch (err) {
        if (replyTextArea) {
          replyTextArea.value = `Dear Ranti,\n\nThank you for always standing by me as my shield and best friend. Wishing you endless happiness, good health, and success on this Raksha Bandhan!\n\nWith love,\nPromi`;
        }
        if (replyAiStatus) {
          replyAiStatus.textContent = 'Populated with sweet reply.';
          setTimeout(() => { replyAiStatus.style.display = 'none'; }, 2500);
        }
      }
    });
  });

  // Save Promi's Reply Card PNG
  document.getElementById('btn-save-promi-reply-png')?.addEventListener('click', () => {
    const msg = replyTextArea?.value || 'Dear Ranti, happy Raksha Bandhan! With all my love, Promi.';
    const shagun = (document.getElementById('promi-return-shagun') as HTMLSelectElement)?.value || 'Unlimited sweets & festive treats';

    const offCanvas = document.createElement('canvas');
    offCanvas.width = 800;
    offCanvas.height = 700;
    const oCtx = offCanvas.getContext('2d');
    if (!oCtx) return;

    oCtx.fillStyle = '#0F121C';
    oCtx.fillRect(0, 0, 800, 700);

    oCtx.strokeStyle = '#F59E0B';
    oCtx.lineWidth = 4;
    oCtx.strokeRect(20, 20, 760, 660);

    oCtx.fillStyle = '#FDE68A';
    oCtx.font = 'bold 24px serif';
    oCtx.textAlign = 'center';
    oCtx.fillText("PROMI'S SMRITI & ASHIRWAD TO RANTI", 400, 80);

    oCtx.textAlign = 'left';
    oCtx.fillStyle = '#FFFFFF';
    oCtx.font = '20px serif';
    oCtx.fillText('From: Promi', 60, 150);
    oCtx.fillText('To: Ranti', 60, 190);

    oCtx.font = '15px sans-serif';
    oCtx.fillStyle = '#E2E8F0';
    
    // Multi-line wrap
    const words = msg.split(' ');
    let line = '';
    let y = 250;
    for (let n = 0; n < words.length; n++) {
      const testLine = line + words[n] + ' ';
      const metrics = oCtx.measureText(testLine);
      if (metrics.width > 680 && n > 0) {
        oCtx.fillText(line, 60, y);
        line = words[n] + ' ';
        y += 28;
      } else {
        line = testLine;
      }
    }
    oCtx.fillText(line, 60, y);

    oCtx.fillStyle = '#F59E0B';
    oCtx.font = '16px serif';
    oCtx.fillText(`Promi's Festive Claim: ${shagun}`, 60, y + 60);

    const a = document.createElement('a');
    a.download = `promi-reply-to-ranti-${Date.now()}.png`;
    a.href = offCanvas.toDataURL('image/png');
    a.click();
    soundEngine.playCelebrationChime();
  });

  // Celebrate Reply Button
  document.getElementById('btn-celebrate-reply')?.addEventListener('click', () => {
    soundEngine.playCelebrationChime();
    triggerPromiPetals();
    setTimeout(triggerPromiPetals, 350);
  });

  // Auto trigger celebratory petals on initial page visit
  setTimeout(() => {
    soundEngine.playTempleBell(1.0);
    triggerPromiPetals();
  }, 600);
</script>
