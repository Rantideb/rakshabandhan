---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Raksha Bandhan • The Sacred Bond of Protection & Eternal Affection",
  description = "A traditional, reverent digital celebration of Shravana Purnima Raksha Bandhan featuring authentic Puja Vidhi, handcrafted Raksha Sutra, sacred vows, and encrypted letters."
} = Astro.props;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph & Social Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Classical Typography: Hind Siliguri (Bengali), Cinzel Decorative, Noto Serif Devanagari, Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@400;600;700&family=Outfit:wght@300;400;500;600;700&family=Rozha+One&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Top-Right Floating Controls (Language Toggle & Soundscape) -->
    <nav class="top-nav-controls" aria-label="Page Controls">
      <!-- EN / BN Language Switcher -->
      <div class="lang-switcher-pill" id="lang-switcher">
        <button type="button" class="lang-btn" id="lang-btn-en" data-lang="en" aria-label="English Version">
          EN
        </button>
        <span class="lang-separator">/</span>
        <button type="button" class="lang-btn active" id="lang-btn-bn" data-lang="bn" aria-label="বাংলা ভার্সন">
          বাংলা
        </button>
      </div>

      <!-- Soundscape Toggle -->
      <button id="sound-toggle-btn" class="sound-toggle-btn" title="Toggle Temple Soundscape" aria-label="Toggle Sound">
        <svg id="sound-on-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
        <svg id="sound-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
      </button>
    </nav>

    <!-- Ambient Marigold & Golden Sparkle Particle Canvas -->
    <canvas id="festive-canvas"></canvas>

    <div class="app-container">
      <slot />
    </div>

    <style>
      .top-nav-controls {
        position: fixed;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .lang-switcher-pill {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: var(--surface-1);
        border: 1px solid var(--border-medium);
        padding: 0.25rem 0.5rem;
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(8px);
      }

      .lang-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-family: 'Hind Siliguri', 'Outfit', sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.2rem 0.45rem;
        border-radius: var(--radius-full);
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .lang-btn:hover {
        color: var(--text-main);
      }

      .lang-btn.active {
        background: var(--accent-gold);
        color: #FFFFFF;
      }

      .lang-separator {
        color: var(--border-medium);
        font-size: 0.75rem;
      }

      .sound-toggle-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--surface-1);
        border: 1px solid var(--border-medium);
        color: var(--accent-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow-sm);
        transition: transform 0.15s ease, border-color 0.15s ease;
      }

      .sound-toggle-btn:hover {
        transform: scale(1.06);
        border-color: var(--border-gold);
      }
    </style>

    <!-- Language Switcher & Canvas Engine Scripts -->
    <script>
      import { soundEngine } from '../utils/audio';
      import { translations, type Locale } from '../utils/i18n';

      // 1. Language Toggle Controller
      const btnEn = document.getElementById('lang-btn-en');
      const btnBn = document.getElementById('lang-btn-bn');

      function setLanguage(lang: Locale) {
        localStorage.setItem('rb_lang', lang);
        document.documentElement.lang = lang;
        if (lang === 'bn') {
          document.body.style.fontFamily = "'Hind Siliguri', 'Outfit', sans-serif";
        } else {
          document.body.style.fontFamily = "'Outfit', sans-serif";
        }

        btnEn?.classList.toggle('active', lang === 'en');
        btnBn?.classList.toggle('active', lang === 'bn');

        // Translate all data-i18n elements
        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n') as keyof typeof translations['en'];
          if (key && translations[lang] && translations[lang][key]) {
            el.textContent = translations[lang][key];
          }
        });

        // Translate placeholders
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder') as keyof typeof translations['en'];
          if (key && translations[lang] && translations[lang][key]) {
            (el as HTMLInputElement).placeholder = translations[lang][key];
          }
        });

        // Dispatch custom event for subcomponents
        window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang } }));
      }

      btnEn?.addEventListener('click', () => {
        setLanguage('en');
        soundEngine.playShimmer();
      });

      btnBn?.addEventListener('click', () => {
        setLanguage('bn');
        soundEngine.playCelebrationChime();
      });

      // Initialize on load - Default to Bengali ('bn')
      const savedLang = (localStorage.getItem('rb_lang') as Locale) || 'bn';
      setLanguage(savedLang);

      document.addEventListener('DOMContentLoaded', () => {
        const current = (localStorage.getItem('rb_lang') as Locale) || 'bn';
        setLanguage(current);
      });

      window.addEventListener('load', () => {
        const current = (localStorage.getItem('rb_lang') as Locale) || 'bn';
        setLanguage(current);
      });

      // 2. Audio Mute Button Hook
      const soundBtn = document.getElementById('sound-toggle-btn');
      const soundOn = document.getElementById('sound-on-icon');
      const soundOff = document.getElementById('sound-off-icon');

      soundBtn?.addEventListener('click', () => {
        const isMuted = soundEngine.toggleMute();
        if (soundOn && soundOff) {
          soundOn.style.display = isMuted ? 'none' : 'block';
          soundOff.style.display = isMuted ? 'block' : 'none';
        }
        if (!isMuted) {
          soundEngine.playTempleBell(1.0);
        }
      });

      // 3. Native Canvas Particle System (Floating Marigold Petals & Gold Dust)
      const canvas = document.getElementById('festive-canvas') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = (canvas.width = document.documentElement.clientWidth || window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        window.addEventListener('resize', () => {
          width = canvas.width = document.documentElement.clientWidth || window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        interface Particle {
          x: number;
          y: number;
          size: number;
          speedY: number;
          speedX: number;
          rotation: number;
          rotSpeed: number;
          color: string;
          type: 'petal' | 'dust';
        }

        const colors = ['#FFA000', '#FFB300', '#FFD54F', '#D32F2F'];
        const particles: Particle[] = [];
        const count = window.innerWidth < 768 ? 12 : 22;

        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            size: Math.random() * 5 + 3,
            speedY: Math.random() * 0.4 + 0.2,
            speedX: (Math.random() - 0.5) * 0.3,
            rotation: Math.random() * Math.PI * 2,
            rotSpeed: (Math.random() - 0.5) * 0.015,
            color: colors[Math.floor(Math.random() * colors.length)],
            type: Math.random() > 0.4 ? 'petal' : 'dust'
          });
        }

        function drawPetal(c: CanvasRenderingContext2D, p: Particle) {
          c.save();
          c.translate(p.x, p.y);
          c.rotate(p.rotation);
          c.beginPath();
          c.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);
          c.fillStyle = p.color;
          c.globalAlpha = 0.55;
          c.fill();
          c.restore();
        }

        function drawDust(c: CanvasRenderingContext2D, p: Particle) {
          c.save();
          c.beginPath();
          c.arc(p.x, p.y, p.size * 0.3, 0, Math.PI * 2);
          c.fillStyle = '#FFE082';
          c.globalAlpha = 0.7;
          c.shadowBlur = 6;
          c.shadowColor = '#FFD54F';
          c.fill();
          c.restore();
        }

        function animate() {
          if (!ctx) return;
          ctx.clearRect(0, 0, width, height);

          for (let i = 0; i < particles.length; i++) {
            const p = particles[i];
            p.y += p.speedY;
            p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;
            p.rotation += p.rotSpeed;

            if (p.y > height + 20) {
              p.y = -20;
              p.x = Math.random() * width;
            }

            if (p.type === 'petal') {
              drawPetal(ctx, p);
            } else {
              drawDust(ctx, p);
            }
          }

          requestAnimationFrame(animate);
        }

        animate();
      }
    </script>
  </body>
</html>
